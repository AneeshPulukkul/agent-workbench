{
  "name": "Agent Operations Workbench (py3.12 + node20)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {},
  "forwardPorts": [8080, 3000, 16686, 9090, 3001],
  "portsAttributes": {
    "8080": { "label": "API", "onAutoForward": "notify" },
    "3000": { "label": "UI", "onAutoForward": "notify" },
    "16686": { "label": "Jaeger", "onAutoForward": "silent" },
    "9090": { "label": "Prometheus", "onAutoForward": "silent" },
    "3001": { "label": "Grafana", "onAutoForward": "silent" }
  },
  "postCreateCommand": "python -m pip install -r requirements.lock && python -m pip install -e \".[dev]\" && npm install",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "bradlc.vscode-tailwindcss", "ms-azuretools.vscode-docker"]
    }
  },
  "remoteUser": "vscode"
}
