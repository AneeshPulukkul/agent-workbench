# Safe placeholders only — never commit real secrets.
# Copy: cp .env.example .env

# Postgres (local compose — required; compose fails fast without these).
# Explicit local-only override: keep `workbench_local_only` in your untracked
# `.env` only. Never commit real passwords.
POSTGRES_USER=workbench
POSTGRES_PASSWORD=workbench_local_only
POSTGRES_DB=workbench
DATABASE_URL=postgresql+psycopg://workbench:workbench_local_only@localhost:5432/workbench

# API / worker
APP_ENV=local
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8080
MCP_SERVER_URL=http://mcp-server:8081
OBSERVABILITY_AGENT_URL=http://observability-agent:8082/a2a
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=agent-api

# Auth (local mock identity; no real IdP)
AUTH_MODE=mock
MOCK_USER_ID=analyst-local
MOCK_TENANT_ID=tenant-local
OIDC_ISSUER_URL=
OIDC_AUDIENCE=

# LLM (mock by default — no cloud calls)
LLM_MODE=fake
LITELLM_MODEL=mock/fake
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# UI
VITE_API_BASE_URL=http://localhost:8080

# Grafana (local compose — required; compose fails fast without these).
# Explicit local-only override: GF_SECURITY_ADMIN_PASSWORD=workbench_local_only
# in your untracked `.env` only.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=workbench_local_only

# Telemetry content capture (local debugging only; default empty = never capture
# prompts/completions/secrets). Set OTEL_CONTENT_CAPTURE=dev-only for redacted
# local debugging; secrets are still redacted even then.
OTEL_CONTENT_CAPTURE=
OTEL_TRACES_CONSOLE=
OTEL_METRICS_CONSOLE=
